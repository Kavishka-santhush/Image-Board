# ============================================================
# Copy this file to .env  (cp .env.example .env) and fill in.
# NEVER commit .env — it holds your RDS password & AWS creds.
# ============================================================

# --- Server ---
PORT=4000

# --- RDS PostgreSQL (local PG is NOT used — point this at your RDS endpoint) ---
# Format: postgres://USER:PASSWORD@RDS_ENDPOINT:5432/DBNAME
# Add ?sslmode=require so the connection is encrypted (RDS requires it from outside a VPC)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/postgres

# Knex connection pool — keep small! Your dev machine AND EC2 both connect to RDS.
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- S3 (image uploads) ---
AWS_REGION=us-east-1
S3_BUCKET=image-board-uploads-kavishka-123
# local dev: needs AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in env
# (or ~/.aws/credentials). On EC2: NOTHING here — the instance profile
# (IAM role attached to the server) provides credentials automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Upload rules
UPLOAD_MAX_MB=5
PRESIGN_TTL_SEC=300
# Step 7 flip: TRUE — the browser now uploads to S3 for real, so
# POST /posts only accepts keys this server issued AND verified landed
# in the bucket. (If your .env still says false — change it too!)
REQUIRE_ISSUED_KEY=true




AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
